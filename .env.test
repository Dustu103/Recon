# Test environment — overrides applied before every test suite.
# MONGODB_URI is injected dynamically by global-setup (mongodb-memory-server).
MONGODB_URI=mongodb://localhost:27017/taro_test
JWT_SECRET=test_jwt_secret_that_is_32_chars_long!!
GEMINI_API_KEY=test_key_placeholder
PORT=4001
NODE_ENV=test
ALLOWED_ORIGINS=http://localhost:3000
LLM_TPM_LIMIT=999999
LLM_RPM_LIMIT=999
LLM_MAX_RETRIES=4
