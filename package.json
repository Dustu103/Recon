{
  "name": "taro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "tsx watch src/api/index.ts",
    "build": "npm run build:api",
    "build:all": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm run --workspace=apps/web build",
    "lint": "npm run lint --workspace=apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shared": "vitest run src/shared",
    "test:core": "vitest run src/core",
    "test:api": "vitest run src/api",
    "test:cli": "vitest run src/cli",
    "evaluate": "tsx src/cli/evaluate.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.5.4",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "minimist": "^1.2.8",
    "mongoose": "^8.5.4",
    "typescript": "^5.5.4",
    "undici": "^6.19.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "eslint-plugin-react": "7.35.0"
  }
}
