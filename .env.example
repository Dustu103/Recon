# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas M0 (free tier). Get connection string from Atlas dashboard.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/taro?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_minimum_32_char_random_secret_string

# ── LLM Provider (set at least one) ──────────────────────────────────────────
# Primary: Google Gemini (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Fallback: Groq Llama-3.3-70B (free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiter (LLM) ───────────────────────────────────────────────────────
# Tokens per minute allowed before queuing (set conservatively for free tiers)
LLM_TPM_LIMIT=100000
# Requests per minute
LLM_RPM_LIMIT=15
# Max retry attempts on 429/503 before throwing LLM_RATE_LIMITED
LLM_MAX_RETRIES=4
